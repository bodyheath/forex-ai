# Copy this file to .env and fill in your real values.
# .env is gitignored and must NEVER be committed to version control.

# ── Required API keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
TWELVE_DATA_KEY=
NEWS_API_KEY=
FRED_API_KEY=

# ── Optional: personal contact ─────────────────────────────────────────────
MY_EMAIL=

# ── Optional: legacy key (unused, kept for reference) ─────────────────────
ALPHA_VANTAGE_KEY=

# ── Optional model overrides ───────────────────────────────────────────────
# Stage-2 deep analysis model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Stage-1 fast screener model (default: claude-haiku-4-5-20251001)
# HAIKU_MODEL=claude-haiku-4-5-20251001

# ── Optional: Telegram notifications ──────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional behaviour overrides ───────────────────────────────────────────
# Cache TTL in hours — how long API responses are reused (default: 6)
# CACHE_TTL_HOURS=6

# Fallback watchlist used when smart selection fails (comma-separated, no spaces)
# WATCHLIST=EUR/USD,GBP/USD,USD/JPY,AUD/USD,USD/CAD,NZD/USD,EUR/GBP,EUR/JPY
